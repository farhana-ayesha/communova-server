# ---------------------------------------------------------------------------
# Communova API - environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Production deployments must set NODE_ENV=production and a reachable MongoDB.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string.
# Placeholder shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For local development: mongodb://127.0.0.1:27017/communova
MONGODB_URI=mongodb://127.0.0.1:27017/communova
MONGODB_DB=communova

# Origins allowed to call this API (comma-separated for several).
# Add the deployed client origin and any Vercel preview origins.
CLIENT_ORIGIN=http://localhost:3000

# Better Auth base URL. The API fetches public keys from
# ${BETTER_AUTH_URL}/api/auth/jwks to verify member tokens. In production this
# must be the deployed client origin, because it is also the JWT issuer.
BETTER_AUTH_URL=http://localhost:3000

# Must match the audience configured in the client's Better Auth JWT plugin.
JWT_AUDIENCE=communova-api

# Development only: keep events and newsletter subscriptions in a process-local
# store when mongod is not available. Seeded with sample events on first boot;
# refused in production.
# EVENTS_DEV_MEMORY=1
